OPENROUTER_API_KEY=sk-or-your-openrouter-key-here
# Optional — defaults to a free model
# OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free
# Frontend only — leave empty locally, set this in Vercel to your Railway API URL
# VITE_API_BASE_URL=https://api.yourdomain.com
# Optional metadata headers sent to OpenRouter
# OPENROUTER_SITE_URL=http://localhost:5174
# OPENROUTER_SITE_NAME=AI Podcast Studio
# Backend only — comma-separated frontend origins allowed to call the API
# CORS_ORIGINS=http://localhost:5174,https://yourdomain.com
# Optional — default 8787
# PORT=8787
# Optional — SQLite file path used for saved history
# DB_PATH=../data/history.db
